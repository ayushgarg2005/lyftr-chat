# Comma-separated key pool, at least 2. Ids are key_1, key_2, ... in this order.
LLM_API_KEYS=your-first-api-key,your-second-api-key

# Any LiteLLM model string. LLM_MODELS optionally sets one model per key (same order).
LLM_MODEL=gemini/gemini-2.5-flash
LLM_MODELS=

DATABASE_URL=sqlite:////data/app.db
ALLOWED_ORIGINS=http://localhost:3000
ENABLE_FAILURE_SIMULATION=true

# LiteLLM cache: disk (survives restarts, stored in the volume), local (in-memory) or off
CACHE_TYPE=disk
CACHE_DIR=/data/llm_cache
CACHE_TTL_SECONDS=86400

DEFAULT_SYSTEM_PROMPT=You are a helpful assistant. Keep answers clear and concise.
LLM_TIMEOUT_SECONDS=30
MAX_HISTORY_MESSAGES=40

# Frontend: backend URL as seen from the browser
FRONTEND_API_URL=http://localhost:8000
# Used only when building the frontend outside Docker (Vercel/Netlify)
VITE_API_URL=http://localhost:8000
